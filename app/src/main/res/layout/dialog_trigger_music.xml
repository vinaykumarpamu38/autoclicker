<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <RadioGroup
        android:id="@+id/radio_group_music_condition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radio_music_started"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="When music starts playing" />

        <RadioButton
            android:id="@+id/radio_music_stopped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When music genuinely stops or pauses" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="From this app" />

    <Spinner
        android:id="@+id/spinner_music_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/section_music_auto_restore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/checkbox_music_auto_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-restore when music stops" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Whatever this sequence's Set Ringer Mode step changed gets set back automatically once playback genuinely stops."
            android:textColor="@color/automate_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
