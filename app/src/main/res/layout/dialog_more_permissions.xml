<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Grant these in order - background location only becomes available on some devices after foreground location is already granted." />

    <Button
        android:id="@+id/btn_grant_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="1. Grant Location Access (Location + Wi-Fi triggers)" />

    <Button
        android:id="@+id/btn_grant_background_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2. Grant Background Location (&quot;Allow all the time&quot;)" />

    <Button
        android:id="@+id/btn_grant_exact_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Grant Exact Alarm Permission (Scheduled Time trigger)" />

</LinearLayout>
