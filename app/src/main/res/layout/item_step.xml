<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/text_step_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingEnd="4dp"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/button_move_up"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_step_action_circle"
        android:contentDescription="Move up"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_step_move_up" />

    <ImageButton
        android:id="@+id/button_move_down"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_step_action_circle"
        android:contentDescription="Move down"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_step_move_down" />

    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="8dp"
        android:background="@color/automate_divider" />

    <ImageButton
        android:id="@+id/button_remove_step"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_step_action_circle_delete"
        android:contentDescription="Remove"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_step_delete" />

</LinearLayout>