<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/automate_card_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/text_sequence_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_sequence_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/automate_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_run_sequence"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_sequence_run_circle"
            android:contentDescription="Run"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sequence_run" />

        <ImageButton
            android:id="@+id/button_edit_sequence"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_step_action_circle"
            android:contentDescription="Edit"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sequence_edit" />

        <ImageButton
            android:id="@+id/button_share_sequence"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_step_action_circle"
            android:contentDescription="Share"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sequence_share" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/automate_divider" />

        <ImageButton
            android:id="@+id/button_delete_sequence"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_step_action_circle_delete"
            android:contentDescription="Delete"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_step_delete" />

    </LinearLayout>
</androidx.cardview.widget.CardView>